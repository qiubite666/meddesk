# ==============================================================================
# MedDesk —— systemd 服务单元（ops 布局）
# 目标路径：/etc/systemd/system/meddesk.service
# 生效方式：
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now meddesk
#
# 【ops 布局约定】（与 docs/DEPLOYMENT.md、meddesk.env.example 保持一致）
#   /home/ops/service/meddesk/meddesk        -> 二进制（前端已内嵌，单文件）
#   /home/ops/service/meddesk/.meddesk.env   -> 环境变量文件（权限 0640，属主 root:ops）
#   /home/ops/service/meddesk/data/       -> 附件密文落盘（MEDDESK_UPLOAD_DIR）
#   /home/ops/service/meddesk/fonts/         -> PDF 中文字体（MEDDESK_PDF_FONT_PATH 所在目录）
#   运行用户：ops（应用监听 :8080 非特权端口，无需 root / capabilities）
#
# 【安全基线说明】
#   ProtectSystem=strict   : 全文件系统只读，仅 ReadWritePaths 列出的路径可写，
#                            可防止应用被 RCE 后改写系统文件。
#   ProtectHome=read-only  : /home 整体只读（防止被 RCE 后篡改二进制/配置），
#                            uploads 的写权限由 ReadWritePaths 单独放行。
#   NoNewPrivileges=yes    : 禁止 suid 提权。
#   PrivateTmp=yes / PrivateDevices=yes / ProtectKernel* / RestrictSUIDSGID : 收紧内核面。
#   SystemCallFilter       : 白名单式系统调用过滤；若内核/glibc 组合报 SIGSYS，
#                            先注释再二分排查。
#   CapabilityBoundingSet= : 清空 capabilities（不监听 1024 以下端口，不需要 CAP）。
#
# 【重要】.meddesk.env 里存放 JWT 密钥与数据库口令，
#         必须 chown root:ops && chmod 640，且不要提交进 git（.gitignore 已忽略）。
# ==============================================================================

[Unit]
Description=MedDesk 个人数字工作台（端到端加密用药提醒）
Documentation=https://github.com/qiubite666/meddesk
# 重启限流（属 [Unit] 段；写在 [Service] 会被忽略并告警）
StartLimitIntervalSec=300
StartLimitBurst=5
# 兼容两种数据库方案：
#   宿主机安装 —— postgresql.service/redis-server.service 存在，After 负责排序、Wants 负责拉起；
#   Docker compose —— 这些 unit 不存在，After/Wants 对不存在的 unit 自动忽略，不阻断启动。
# ⚠ 不能用 Requires=postgresql.service：compose 方案下该 unit 不存在，会导致本服务直接启动失败。
#   Docker 方案下容器由自身的 restart 策略拉起；应用连不上库时会退出并由 Restart=always 重试自愈。
After=network-online.target docker.service postgresql.service redis-server.service
Wants=network-online.target docker.service
# Redis 只是可选的限流/吊销名单后端（MEDDESK_REDIS_ENABLED=false 可降级），
# 因此用 Wants 而非 Requires：Redis 挂了应用仍应能带降级启动。

[Service]
Type=simple
User=ops
Group=ops

# ---------------------------------------------------------------- 进程与文件
WorkingDirectory=/home/ops/service/meddesk
ExecStart=/home/ops/service/meddesk/meddesk
ExecReload=/bin/kill -HUP $MAINPID

# 环境变量集中在这一个文件里（MEDDESK_* 系列，见 meddesk.env.example）
EnvironmentFile=/home/ops/service/meddesk/.meddesk.env

LimitNOFILE=65535
LimitNPROC=4096

# ---------------------------------------------------------------- 重启策略
Restart=always
RestartSec=5s
# 5 分钟内崩溃超过 5 次就不再拉起，避免 DB 不可用时疯狂重启刷爆日志
# 优雅停止：给正在进行的导出/上传留出收尾时间，超时后 SIGKILL
TimeoutStopSec=30s
KillSignal=SIGTERM
KillMode=mixed

# ---------------------------------------------------------------- 日志
# 应用日志走 stdout -> journald（journalctl -u meddesk），不写文件
StandardOutput=journal
StandardError=journal
SyslogIdentifier=meddesk
# 日志速率兜底属于 journald 的配置（/etc/systemd/journald.conf 的 RateLimitBurst/IntervalSec），
# systemd unit 不支持这两个键（写了会被忽略并告警），故不在此处设置。

# ---------------------------------------------------------------- 安全加固
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectClock=yes
ProtectHostname=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
# /home 整体只读；uploads 的写权限由下面的 ReadWritePaths 单独放行
ProtectHome=read-only
ProtectSystem=strict
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
RestrictRealtime=yes
SystemCallArchitectures=native
UMask=0027
CapabilityBoundingSet=
AmbientCapabilities=
# 若在某些内核上因 seccomp 过滤导致启动即退出（status=203/EXEC 或 SIGSYS），
# 先注释下面一行验证是否为该原因，再逐步收紧。
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# ProtectSystem=strict / ProtectHome=read-only 下必须显式放开的「可写」路径
ReadWritePaths=/home/ops/service/meddesk/data
# 若上传目录尚未创建，先：sudo install -d -o ops -g ops -m 0750 /home/ops/service/meddesk/data
# 导出（PDF/CSV）是纯内存渲染，不落盘；不要放开其他写路径。

[Install]
WantedBy=multi-user.target
