# ==============================================================================
# MedDesk —— systemd 服务单元
# 目标路径：/etc/systemd/system/meddesk.service
# 生效方式：
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now meddesk
#
# 【部署前必须替换/确认的占位符】
#   /opt/meddesk/bin/meddesk            -> 二进制实际安装路径（见 deploy/scripts/install.sh）
#   /etc/meddesk/meddesk.env            -> 环境变量文件（权限必须是 0600，属主 meddesk）
#   /var/lib/meddesk/uploads            -> MEDDESK_UPLOAD_DIR，必须在 ReadWritePaths 里显式放开
#   User=meddesk / Group=meddesk        -> 由 install.sh 创建的无登录系统用户
#
# 【安全基线说明】
#   ProtectSystem=strict   : 全文件系统只读，仅 ReadWritePaths 列出的路径可写，
#                            可防止应用被 RCE 后改写系统文件。
#   NoNewPrivileges=yes    : 禁止 suid 提权。
#   ProtectHome=yes        : 屏蔽 /home /root /run/user。
#   PrivateTmp=yes         : 独立 /tmp。
#   PrivateDevices=yes     : 屏蔽物理设备。
#   ProtectKernel* / RestrictSUIDSGID / LockPersonality : 内核面收紧。
#   SystemCallFilter       : 白名单式系统调用过滤（Go 运行时需要 @basic-io @timer @network-io 等，
#                            若你的内核/glibc 组合报 SIGSYS，先注释掉再二分排查）。
#   CapabilityBoundingSet= : 清空 capabilities（不监听 1024 以下端口，不需要 CAP_NET_BIND_SERVICE）。
#
# 【重要】EnvironmentFile 里存放 JWT 密钥与数据库口令，
#         必须 chown meddesk:meddesk && chmod 600，且不要提交进 git。
# ==============================================================================

[Unit]
Description=MedDesk 个人数字工作台（端到端加密用药提醒）
Documentation=https://github.com/qiubite666/meddesk
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target
# Redis 只是可选的限流/吊销名单后端（MEDDESK_REDIS_ENABLED=false 可降级），
# 因此用 Wants 而非 Requires：Redis 挂了应用仍应能带降级启动。
Requires=postgresql.service

[Service]
Type=simple
User=meddesk
Group=meddesk

# ---------------------------------------------------------------- 进程与文件
WorkingDirectory=/var/lib/meddesk
ExecStart=/opt/meddesk/bin/meddesk
ExecReload=/bin/kill -HUP $MAINPID

# 环境变量集中在这一个文件里（MEDDESK_* 系列，见 deploy/env.example）
EnvironmentFile=/etc/meddesk/meddesk.env

# PID / 文件描述符
PIDFile=/run/meddesk/meddesk.pid
RuntimeDirectory=meddesk
RuntimeDirectoryMode=0755
LogsDirectory=meddesk
StateDirectory=meddesk
LimitNOFILE=65535
LimitNPROC=4096

# ---------------------------------------------------------------- 重启策略
Restart=always
RestartSec=5s
# 5 分钟内崩溃超过 5 次就不再拉起，避免 DB 不可用时疯狂重启刷爆日志；
# 配 StartLimitBurst 使用。
StartLimitBurst=5
StartLimitIntervalSec=300
# 优雅停止：给正在进行的导出/上传留出收尾时间，超时后 SIGKILL
TimeoutStopSec=30s
KillSignal=SIGTERM
KillMode=mixed

# ---------------------------------------------------------------- 日志
StandardOutput=journal
StandardError=journal
SyslogIdentifier=meddesk
# 日志速率兜底：控制台输出最多 5 秒 1000 条，防止异常时打爆 journald
RateLimitBurst=1000
RateLimitIntervalSec=5

# ---------------------------------------------------------------- 安全加固
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectClock=yes
ProtectHostname=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectSystem=strict
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
RestrictRealtime=yes
SystemCallArchitectures=native
UMask=0027
CapabilityBoundingSet=
AmbientCapabilities=
# 若在某些内核上因 seccomp 过滤导致启动即退出（status=203/EXEC 或 SIGSYS），
# 先注释下面一行验证是否为该原因，再逐步收紧。
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# ProtectSystem=strict 下必须显式放开的「可写」路径
ReadWritePaths=/var/lib/meddesk /var/log/meddesk /run/meddesk
# 二进制与静态资源只读即可（显式声明便于审计）
ReadOnlyPaths=/opt/meddesk
# 如需 Bloodhound 式雪藏的临时下载/导出目录，不要放开；导出是纯内存渲染，不落盘。

[Install]
WantedBy=multi-user.target
