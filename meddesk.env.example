# ==============================================================================
# MedDesk 环境变量样例
# ==============================================================================
# 使用方式（任选其一）：
#   1) systemd 方案：复制本文件到 /home/ops/service/.meddesk.env（点前缀，真实配置不进 git）
#                    chmod 640 /home/ops/service/.meddesk.env && chown root:ops ...
#                    deploy/systemd/meddesk.service 通过 EnvironmentFile 读取它
#   2) Docker 方案：复制本文件为 .env             （compose 的 env_file 会读取根目录 .env）
#   3) 开发环境   ：cp .env.example .env         （godotenv 会自动加载仓库根目录的 .env）
#
# 优先级：真实环境变量 > .env 文件 > 代码默认值
#
# ⚠⚠⚠ 安全红线 ⚠⚠⚠
#   1. **所有 <...> 占位符必须替换**，禁止把本文件原样用于生产环境。
#   2. 本文件含密钥，绝不允许提交到公开仓库；.gitignore 里应有 .env 与 *.env。
#   3. 生成强随机值的命令：
#        JWT 密钥（≥32 字节） : openssl rand -base64 48
#        数据库/Redis 口令     : openssl rand -base64 24
#        无 openssl 时           : head -c 48 /dev/urandom | base64
#   4. 修改 MEDDESK_JWT_SECRET 会导致**所有已签发的访问令牌立即失效**，
#      用户需要重新登录；本地 IndexedDB 数据不受影响（本地数据除非执行
#      「清空全部数据」或卸载浏览器数据，否则不会丢），但需注意：改密钥前请先确认
#      用户记得自己的口令——MedDesk 是端到端加密，**服务端无法帮他重置**。
#   5. MEDDESK_SIGNUP_ENABLED=true 意味着任何人都能注册，公网部署务必设为 false。
# ==============================================================================

# ------------------------------------------------------------------ 运行环境
# dev | prod。dev 下会有更宽松的 CORS/日志；prod 请务必置为 prod。
MEDDESK_ENV=prod

# HTTP 监听地址。默认 :8080；由 Nginx 反代时**保持默认**即可，
# 不要改成对外网卡地址（失去 Nginx 的 TLS/限流/安全头兜底）。
MEDDESK_HTTP_ADDR=:8080

# 站点外链基址（用于邮件/导出/分享链接；一期未发邮件，仅占位）。
# 公网部署请改成 https://<你的域名>，注意结尾不要带斜杠。
MEDDESK_BASE_URL=https://med.example.com

# 是否信任反向代理的 X-Forwarded-For / X-Real-IP。
# 前面有 Nginx 时必须设为 true，否则客户端 IP 全是 127.0.0.1，
# 会导致限流与登录失败计数「一荣俱荣、一损俱损」。
MEDDESK_TRUST_PROXY=true

# 静态资源目录。留空 = 使用二进制内嵌的 web/（生产推荐）；
# 开发时设为 ./web，改前端不用重新编译 Go：
#   MEDDESK_WEB_DIR=./web go run ./cmd/meddesk
MEDDESK_WEB_DIR=

# ------------------------------------------------------------------ 数据库
# PostgreSQL 连接串。sslmode 说明：
#   disable    本机/容器内网（当前默认）
#   require    加密但不校验证书
#   verify-full最安全，需配 CA
# 中文/邮件等均为 UTF-8，客户端编码由 pgx 自动处理，无需额外参数。
MEDDESK_DB_URL=postgres://meddesk:<请替换为-openssl-rand-base64-24-生成的口令>@127.0.0.1:5432/meddesk?sslmode=disable

# 连接池上限。必须满足：MEDDESK_DB_MAX_CONNS × 实例数 < PG 的 max_connections - 3
MEDDESK_DB_MAX_CONNS=10
# 连接池下限（预热连接），小机设 1 即可
MEDDESK_DB_MIN_CONNS=1
# 单连接最长存活时间，避免长期连接被 LB/防火墙静默断开后出现「第一次请求必失败」
MEDDESK_DB_MAX_CONN_LIFETIME=30m
# 启动时自动执行迁移（幂等，依赖 schema_migrations 表）。
# 生产建议保留 true（迁移由应用保证幂等），多实例滚动发布时请只在首批实例开启。
MEDDESK_DB_MIGRATE_ON_BOOT=true

# ------------------------------------------------------------------ Redis
# 默认关闭：单实例部署走进程内 Noop 实现（限流/失败计数/吊销名单仅在单进程内生效），
# 功能完全等价，少维护一个中间件；多副本部署或需跨进程共享时再改为 true。
MEDDESK_REDIS_ENABLED=false
# 格式 redis://[:<口令>@]<host>:<port>/<db> ；TLS 用 rediss://
MEDDESK_REDIS_URL=redis://:<请替换为-openssl-rand-base64-24-生成的口令>@127.0.0.1:6379/0

# ------------------------------------------------------------------ 鉴权
# 【必填】JWT 签名密钥，长度必须 ≥ 32 字节。
#   生成：openssl rand -base64 48
#   轮换：改这个值会让所有 access token 立即失效（需重新登录）；
#         建议配合先在低峰期操作，并提前告知用户。
MEDDESK_JWT_SECRET=<请用-openssl-rand-base64-48-生成-至少32字节>

# 访问令牌有效期。建议保持 15m，过长会增加令牌泄露后的风险窗口。
# 客户端在收到 401 后会用刷新令牌静默换新（内部契约见部署文档的令牌小节）。
MEDDESK_ACCESS_TTL=15m

# 刷新令牌有效期，720h = 30 天。
# 注意：刷新令牌每次使用都会**轮换**，并重放检测；超过 TTL 后需重新登录。
MEDDESK_REFRESH_TTL=720h

# ------------------------------------------------------------------ Argon2id 参数
# 服务端对「客户端 PBKDF2 结果」再做一次 argon2id 后存储。
# 这三个参数直接影响登录时的 CPU/内存开销：**改了会让现有用户无法验证吗？**
#   不会——参数写在哈希串里（$argon2id$v=19$m=...,t=...,p=...$salt$hash），
#   验证时按串内参数执行。但改参数后需要用户下次改口令才会用上新值。
# 65536 KiB = 64 MiB 内存 / 迭代 3 / 并行 2 —— 2C4G 小机的稳妥值，
# 更弱的机器可降到 m=32768,t=3,p=1；更强的机器建议升到 131072。
MEDDESK_ARGON2_MEMORY=65536
MEDDESK_ARGON2_ITERATIONS=3
MEDDESK_ARGON2_PARALLELISM=2

# 是否允许公开注册。公网部署务必 false。
# 关闭后如何创建第一个账号：临时改成 true -> 重启 -> 注册 -> 改回 false -> 重启。
MEDDESK_SIGNUP_ENABLED=false

# 刷新令牌并发宽限期。移动端多标签页同时刷新时，后到的请求会用到已被轮换的旧令牌，
# 在这个时间窗内视为合法并发而非重放攻击。
MEDDESK_REFRESH_REUSE_GRACE=30s

# ------------------------------------------------------------------ 同步
# 单次 push 最大条数（超出返回 bad_request）
MEDDESK_SYNC_MAX_ITEMS=500
# 单条密文上限，默认 1048576 = 1 MiB
MEDDESK_SYNC_MAX_RECORD_BYTES=1048576
# pull 默认分页大小
MEDDESK_SYNC_PULL_PAGE=300
# pull 分页上限（客户端传更大的 limit 会被夹到这里）
MEDDESK_SYNC_PULL_PAGE_MAX=1000

# ------------------------------------------------------------------ 附件
# 密文附件落盘根目录。systemd 方案必须在 ReadWritePaths 中显式放开；
# Docker 方案必须挂持久卷。**丢了 = 药物照片永久不可恢复**（无备份则无法找回）。
MEDDESK_UPLOAD_DIR=/home/ops/service/uploads
# 单个附件密文大小上限，8388608 = 8 MiB。
# 客户端会先把照片压到最长边 ≤1280px、JPEG q=0.82 再加密，一般远低于此值。
# Nginx 侧 client_max_body_size 需要 ≥ 此值 + 少量 multipart 开销（见 nginx 配置）。
MEDDESK_UPLOAD_MAX_BYTES=8388608

# ------------------------------------------------------------------ PDF 导出
# 中文 TrueType 字体路径。留空时按以下顺序自动探测：
#   1 /home/ops/service/fonts/NotoSansSC-Regular.ttf
#   2 /usr/share/fonts/truetype/noto/NotoSansSC-Regular.ttf
#   3 /usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc
#   4 /usr/share/fonts/truetype/wqy/wqy-zenhei.ttc
# 全部失败 → PDF 导出接口返回 503（提示「请先安装中文字体或配置 MEDDESK_PDF_FONT_PATH」）。
# 获取字体：bash deploy/scripts/get-font.sh
MEDDESK_PDF_FONT_PATH=/home/ops/service/fonts/NotoSansSC-Regular.ttf

# ------------------------------------------------------------------ 日志
# debug | info | warn | error。debug 会打出请求/同步明细，**生产慎用**（信息量大）。
MEDDESK_LOG_LEVEL=info
# json（推荐，便于 journald/loki 检索）| text（本地开发可读性好）
MEDDESK_LOG_FORMAT=json

# ------------------------------------------------------------------ 限流
# 每 IP 令牌桶速率与突发上限。Nginx 侧还有一层更强的限制（见 deploy/nginx/meddesk.conf）。
# 家庭自用（1~5 人）20/60 足够；发现大量 429 可适当上调。
MEDDESK_RATE_LIMIT_RPS=20
MEDDESK_RATE_LIMIT_BURST=60

# ------------------------------------------------------------------ CORS
# 逗号分隔的允许来源；留空 = 同源（推荐）。
# 只有在「前端与 API 不同域」时才需要填，且**不要填 ***（本项目所有接口都带凭据）。
MEDDESK_CORS_ALLOWED_ORIGINS=

# ==============================================================================
# 附录：最小可用检查清单
#   1. openssl rand -base64 48                      # 填进 MEDDESK_JWT_SECRET
#   2. openssl rand -base64 24                      # 填进 DB / Redis 口令
#   3. chmod 640 /home/ops/service/.meddesk.env     # 收紧权限
#   4. curl -fsS https://med.example.com/api/v1/health
#   5. curl -fsS https://med.example.com/api/v1/ready
# ==============================================================================
